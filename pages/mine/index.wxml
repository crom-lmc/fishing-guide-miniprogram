<view class="wrap {{tc}}">

  <!-- 登录态头部：纯静默登录，未登录只给提示，不弹按钮 -->
  <view class="card profile">
    <view class="p-av">
      <image wx:if="{{isLogin && avatarUrl}}" src="{{avatarUrl}}" class="p-avimg" mode="aspectFill"/>
      <view wx:else class="p-avph">{{isLogin ? '微' : ''}}</view>
    </view>
    <view class="p-main">
      <block wx:if="{{isLogin}}">
        <view class="p-name">{{nickname}}</view>
        <view class="p-sub">云同步已开启 · 换手机不丢数据</view>
        <view class="p-act">
          <text class="p-link" bindtap="editProfile">编辑资料</text>
        </view>
      </block>
      <block wx:else>
        <view class="p-name">未登录</view>
        <view class="p-sub">登录后可跨设备同步渔获与钓点</view>
      </block>
    </view>
  </view>

  <!-- 编辑资料弹窗（P3）：头像用 chooseAvatar，昵称用 nickname 输入 -->
  <view class="mask" wx:if="{{editing}}" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sh-grab"></view>
      <view class="sh-title">编辑资料</view>
      <button class="ava-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="ava-wrap">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="ava-prev" mode="aspectFill"/>
          <view wx:else class="ava-ph">微</view>
        </view>
        <view class="ava-badge">更换</view>
      </button>
      <view class="ava-tip">点击头像，使用微信头像</view>
      <input class="nick" type="nickname" placeholder="点击设置昵称" placeholder-class="nick-ph" value="{{nickname}}" bindinput="onNick" bindblur="onNick" bindconfirm="onNick"/>
      <view class="btn {{saving ? 'dis' : ''}}" bindtap="saveProfile">保存</view>
    </view>
  </view>

  <view class="card accent">
    <text class="h2">我的钓鱼</text>
    <view class="stats stats4 mt">
      <view class="stat"><view class="v">{{stat.times}}</view><view class="k">出钓次数</view></view>
      <view class="stat"><view class="v">{{stat.total}}</view><view class="k">累计渔获（尾）</view></view>
      <view class="stat"><view class="v">{{stat.max}}</view><view class="k">最大单尾（kg）</view></view>
      <view class="stat"><view class="v">{{stat.hours}}</view><view class="k">累计时长（h）</view></view>
    </view>
  </view>

  <view class="card">
    <view class="entry" data-url="/pages/log/index" bindtap="go">
      <text class="ico">📒</text>
      <view class="eb"><text class="nm">渔获日志</text><text class="small muted">记录每次出钓，可云同步备份</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" data-url="/pages/map/index" bindtap="go">
      <text class="ico">📍</text>
      <view class="eb"><text class="nm">钓点地图</text><text class="small muted">已收藏 {{spots}} 个钓点</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" data-url="/pages/nearby/index" bindtap="go">
      <text class="ico">🌊</text>
      <view class="eb"><text class="nm">附近水域</text><text class="small muted">按半径找河流、水库、湖泊</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" data-url="/pages/gear/index" bindtap="go">
      <text class="ico">🎒</text>
      <view class="eb"><text class="nm">装备清单</text><text class="small muted">已备齐 {{gearDone}} / {{gearTotal}} 项</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" bindtap="goStats">
      <text class="ico">📊</text>
      <view class="eb"><text class="nm">数据统计</text><text class="small muted">月度走势、鱼种构成、单尾纪录</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" bindtap="toggleTheme">
      <text class="ico">{{themeIcon}}</text>
      <view class="eb"><text class="nm">外观</text><text class="small muted">{{themeName}}，点击设置</text></view>
      <view class="tk {{themeLight ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="entry" data-url="/pages/sync/index" bindtap="go">
      <text class="ico">☁️</text>
      <view class="eb"><text class="nm">云同步</text><text class="small muted">换手机不丢日志与钓点</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="entry" data-url="/pages/rules/index" bindtap="go">
      <text class="ico">⚠️</text>
      <view class="eb"><text class="nm">安全与法规</text><text class="small muted">高压线、禁渔期、涉水安全</text></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="sh-head">
      <text class="h3">分享给钓友</text>
      <view class="sh-share">
        <button class="share-btn" open-type="share">分享</button>
      </view>
    </view>
    <view class="qrbox">
      <image class="qrimg" src="/images/wxacode.png" mode="aspectFit" bindlongpress="saveQr" />
      <view class="qtx">
        <text class="small">让钓友用微信扫这个码，直接打开「钓鱼指南」。</text>
        <text class="tiny muted">长按左边这张码可保存到相册，发到群里或朋友圈。</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="h3">关于</text>
    <text class="small muted mt">钓鱼指南 · 从入门到上鱼。出钓指数、鱼种图鉴、钓法教学、饵料配方、装备清单与渔获记录，全部数据仅保存在本机，不会上传。</text>
    <view class="hr"></view>
    <view class="btn ghost wide" bindtap="clearAll">清空本机数据</view>
  </view>

</view>
