<view class="wrap {{tc}}">
  <!-- 吸顶区：滚动时进度条 + 搜索框固定在顶部 -->
  <view class="fstick">
    <!-- 图鉴解锁进度：解锁数来自渔获日志（钓到过即解锁） -->
    <view class="card fprog">
      <view class="fprog-hd">
        <text class="fprog-title">图鉴解锁</text>
        <text class="fprog-num">{{prog.got}}/{{prog.total}}</text>
      </view>
      <view class="fprog-bar">
        <view class="fprog-fill" style="width: {{prog.pct}}%"></view>
      </view>
    </view>

    <view class="card">
      <input class="search" placeholder="搜鱼名或别名，如 草鱼 / 鲫 / 翘嘴" placeholder-class="ph"
             value="{{kw}}" bindinput="onSearch" />
    </view>
  </view>

  <view class="filters">
    <view wx:for="{{cats}}" wx:key="*this"
          class="chip {{cat === item ? 'on' : ''}}"
          data-c="{{item}}" bindtap="setCat">{{item}}</view>
  </view>

  <!-- 名称/别名没命中时的降级说明 -->
  <view class="note mt" wx:if="{{fuzzy}}">
    <text class="tiny">没有鱼种名匹配，「{{kw}}」是按水层与栖息地找到的习性相关鱼种</text>
  </view>

  <view class="item" wx:for="{{list}}" wx:key="n" data-n="{{item.n}}" bindtap="open">
    <view class="body">
      <view class="nm-row">
        <text class="nm">{{item.n}}</text>
        <text class="nm-catch" wx:if="{{item._n > 0}}">已钓 {{item._n}} 次</text>
      </view>
      <view class="sub">{{item.al}}</view>
      <view class="mt">
        <text class="tag">{{item.layer}}</text>
        <text class="tag {{item.w === '海水' ? 'b' : 'g'}}">{{item.w}}</text>
      </view>
    </view>
    <!-- 右侧：鱼形配图 + 解锁状态上下叠放；未解锁置灰 -->
    <view class="fside">
      <view class="fthumb {{item._locked ? 'locked' : ''}}">
        <image class="fimg" src="{{item._src}}" mode="aspectFit" lazy-load
               wx:if="{{item._src && !item._broken}}"
               binderror="onImgErr" data-i="{{index}}"></image>
        <text class="fchar" wx:else>{{item.n[0]}}</text>
      </view>
      <text class="upill {{item._locked ? 'off' : 'on'}}">{{item._locked ? '未解锁' : '已解锁'}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">没有匹配的鱼种，换个词试试</view>
</view>
