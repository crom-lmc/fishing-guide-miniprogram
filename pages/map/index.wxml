<view class="wrap {{tc}}">
  <view class="card accent">
    <text class="h2">钓点地图</text>
    <text class="small muted">把常去的钓点标在地图上，出钓前一眼看全。钓点存在本机，可点「分享」转发给钓友。</text>
  </view>

  <map id="spotMap" class="map" latitude="{{lat}}" longitude="{{lng}}"
       markers="{{markers}}" scale="12" show-location bindregionchange="onRegionChange" style="width:100%;height:520rpx"></map>

  <view class="btn-row mt">
    <view class="btn ghost" bindtap="locate">📍 我的位置</view>
    <view class="btn" bindtap="addSpot">＋ 添加钓点</view>
  </view>

  <text class="geo" wx:if="{{geoMsg}}">{{geoMsg}}</text>

  <!-- 好友分享进来的钓点：数据来自页面参数，不在本机 storage 里 -->
  <view class="card mt2 spot" wx:if="{{shared}}">
    <view class="lrow">
      <text class="sico">🎁</text>
      <text class="h3 snm">好友分享的钓点</text>
      <text class="delpill" bindtap="dismissShared">忽略</text>
    </view>
    <view class="sind">
      <text class="small muted">{{shared.name}}{{shared.addr ? ' · ' + shared.addr : ''}}</text>
      <view class="ops mt">
        <text class="btn sm" bindtap="saveShared">＋ 收藏到我的钓点</text>
        <text class="btn ghost sm" bindtap="navShared">🧭 导航到钓点</text>
      </view>
    </view>
  </view>

  <view class="card mt2 spot" wx:for="{{spots}}" wx:key="id">
    <view class="lrow" data-id="{{item.id}}" bindtap="openSpot">
      <text class="sico">📍</text>
      <text class="h3 snm">{{item.name}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="sind">
      <text class="small muted" wx:if="{{item.addr}}">{{item.addr}}</text>
      <view class="chips" wx:if="{{item.tags.length > 0}}">
        <text class="chip sm" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
      <view class="ops spotops mt">
        <text class="btn ghost sm" data-s="{{item}}" bindtap="navToSpot">🧭 导航到钓点</text>
        <button class="sbtn" hover-class="none" open-type="share"
                data-name="{{item.name}}" data-addr="{{item.addr}}"
                data-lat="{{item.lat}}" data-lng="{{item.lng}}">分享</button>
        <text class="delpill" data-id="{{item.id}}" bindtap="del">删除</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{spots.length === 0 && !shared}}">还没有收藏钓点，点「添加钓点」把你常去的位置记下来。</view>

  <view class="card">
    <text class="tiny muted">出钓前请自行确认该处是否允许垂钓；收费钓场请事先征得同意并缴费。</text>
  </view>

  <!-- 导航到钓点：路线规划面板（与钓点详情页同款） -->
  <view class="route-mask" wx:if="{{routeVisible}}" bindtap="closeRoute">
    <view class="route-sheet" catchtap="stop">
      <view class="route-hd">
        <text class="route-title">导航到钓点</text>
        <text class="route-close" bindtap="closeRoute">✕</text>
      </view>

      <view class="route-tabs">
        <text class="rt {{routeMode==='driving'?'on':''}}" data-mode="driving" bindtap="switchRouteMode">🚗 驾车</text>
        <text class="rt {{routeMode==='bicycling'?'on':''}}" data-mode="bicycling" bindtap="switchRouteMode">🚲 骑行</text>
        <text class="rt {{routeMode==='walking'?'on':''}}" data-mode="walking" bindtap="switchRouteMode">🚶 步行</text>
      </view>

      <view class="route-body" wx:if="{{routeLoading}}">
        <text class="small muted">正在规划路线…</text>
      </view>
      <view class="route-body" wx:elif="{{routeErr}}">
        <text class="small muted">{{routeErr}}</text>
      </view>
      <view class="route-body" wx:elif="{{route}}">
        <map wx:if="{{pline.length}}" class="route-map" id="routeMapNav"
             latitude="{{mapPts[0].latitude}}" longitude="{{mapPts[0].longitude}}"
             polyline="{{pline}}" include-points="{{mapPts}}"
             enable-zoom="{{false}}" enable-scroll="{{false}}" enable-rotate="{{false}}">
        </map>
        <view class="route-sum">
          <view class="rs"><text class="rs-v">{{route._dist}}</text><text class="rs-k">距离</text></view>
          <view class="rs"><text class="rs-v">{{route._dur}}</text><text class="rs-k">预计{{route.modeName}}</text></view>
        </view>
        <view class="route-steps">
          <view class="rstep" wx:for="{{route.steps}}" wx:key="index">
            <text class="rsi">{{index+1}}</text>
            <text class="rsx">{{item.text}}{{item._dt}}</text>
          </view>
          <text class="tiny muted" wx:if="{{route.steps.length === 0}}">沿途指引暂不可用，直接开始导航即可。</text>
        </view>
      </view>

      <view class="route-actions">
        <text class="btn ghost" bindtap="closeRoute">关闭</text>
        <text class="btn" bindtap="startNav">开始导航</text>
      </view>
    </view>
  </view>
</view>
