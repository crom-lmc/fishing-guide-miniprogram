<view class="wrap {{tc}}" wx:if="{{spot}}">

  <view class="pvbox">
    <!-- 540×792 = 600×880 等比缩放，保证绘制时 scale 不会变形 -->
    <canvas type="2d" id="posterCv" class="cv" style="width:540rpx;height:792rpx"></canvas>
  </view>

  <text class="tiny muted mt" wx:if="{{msg}}">{{msg}}</text>

  <view class="btn-row mt2">
    <view class="btn ghost" bindtap="rebuild">重新生成</view>
    <view class="btn {{ready ? '' : 'dis'}}" bindtap="save">保存到相册</view>
  </view>

  <view class="center mt">
    <text class="tiny plink" bindtap="preview">预览大图（可长按保存到相册）</text>
  </view>

  <view class="card mt2">
    <text class="tiny muted">小程序码由云函数 wxacode 生成；未部署时海报照常生成，只是底部没有码。好友扫码后会打开钓点详情页——但钓点数据在你本机，对方看到的是他自己的钓点列表，所以分享钓点请改用详情页的「分享给钓友」。</text>
  </view>
</view>
