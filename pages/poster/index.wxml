<view class="wrap {{tc}}" wx:if="{{spot}}">

  <view class="pvbox">
    <!-- 宽度固定 540rpx，高度由内容算出来回写（cvH），无照片时不会留一大块空白 -->
    <canvas type="2d" id="posterCv" class="cv" style="width:540rpx;height:{{cvH}}rpx"></canvas>
  </view>

  <text class="tiny muted mt" wx:if="{{msg}}">{{msg}}</text>

  <view class="btn-row mt2">
    <view class="btn ghost" bindtap="rebuild">重新生成</view>
    <view class="btn {{ready ? '' : 'dis'}}" bindtap="save">保存到相册</view>
  </view>

  <view class="center mt">
    <text class="tiny plink" bindtap="preview">预览大图（可长按保存到相册）</text>
  </view>

  <view class="hint mt" wx:if="{{noPhoto}}">
    <text class="tiny muted">这个钓点还没有照片，海报用的是文字版头部</text>
    <text class="tiny plink" bindtap="goSpot">去补一张 ›</text>
  </view>

  <view class="card mt2">
    <text class="tiny muted">海报底部的小程序码：云函数 wxacode 可用时用「带钓点参数的专属码」，未部署或超时就自动回落到内置码（images/wxacode.png），不会再缺码。注意钓点数据只存在本机，好友扫码看到的是他自己的钓点列表，所以分享具体钓点请改用详情页的「分享给钓友」。</text>
  </view>
</view>
