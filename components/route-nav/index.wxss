/* 导航到钓点：底部路线规划面板
   样式从 app.wxss 搬到这里，随组件走，页面不再各自维护一份 */
.route-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45); z-index: 60;
  display: flex; align-items: flex-end;
}
.route-sheet {
  width: 100%; max-height: 82vh; display: flex; flex-direction: column;
  background: var(--card); border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box;
}
.route-hd { display: flex; align-items: center; justify-content: space-between; }
.route-title { font-size: 32rpx; font-weight: 700; color: var(--tx); }
.route-close { font-size: 32rpx; color: var(--muted); padding: 6rpx 10rpx; }
.route-tabs { display: flex; gap: 14rpx; margin: 20rpx 0; }
.rt {
  flex: 1; text-align: center; font-size: 26rpx; padding: 14rpx 0;
  border-radius: 12rpx; background: var(--card2); color: var(--muted);
}
.rt.on { background: linear-gradient(135deg, var(--a1), var(--a2)); color: #0E1119; font-weight: 600; }
.route-body { overflow-y: auto; flex: 1; min-height: 120rpx; }
.route-map {
  width: 100%; height: 300rpx; border-radius: 14rpx;
  display: block; margin-bottom: 16rpx;
}
.route-sum { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.rs { flex: 1; background: var(--card2); border-radius: 14rpx; padding: 18rpx; text-align: center; }
.rs-v { display: block; font-size: 30rpx; font-weight: 700; color: var(--tx); }
.rs-k { display: block; font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.route-steps { display: flex; flex-direction: column; gap: 4rpx; }
.rstep { display: flex; align-items: flex-start; gap: 14rpx; padding: 10rpx 0; border-bottom: 1rpx solid var(--line); }
.rsi {
  flex-shrink: 0; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(67, 196, 191, .16); color: var(--a2);
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
}
.rsx { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.5; color: var(--tx); }
.route-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.route-actions .btn { flex: 1; }
